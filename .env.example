# Database
MONGODB_URI=mongodb://localhost:27017/hiretrack

# Auth
JWT_SECRET=replace-with-a-long-random-string
CRON_SECRET=replace-with-a-long-random-string

# Public URL
BASE_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# GitHub Releases (installer + in-app update check). Optional; default is vipul-upforce/hiretrack.
# Set this only if you fork and publish your own Releases.
# GITHUB_RELEASE_REPO=yourname/hiretrack
# Optional: higher GitHub API rate limit, or private release assets
# GITHUB_TOKEN=

# Captcha (optional)
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# Error reporting (optional). Leave empty to disable Sentry.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=

# Google Calendar webhooks (set in production; do not rely on the default)
# GOOGLE_CALENDAR_WEBHOOK_TOKEN=

# Optional AI / mail / storage — configure in the app settings UI or set here
# GEMINI_API_KEY=
# GROQ_API_KEY=
# DOCLING_PARSE_URL=http://127.0.0.1:8000/parse
