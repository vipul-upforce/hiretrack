# Sentry Config File
.env.sentry-build-plugin

# Local lint/type reports (machine paths)
eslint-report.html
report.html
lint-report.txt
typescript-errors.txt

# CI / ci_prod release artifacts (published to GitHub; large, do not commit)
/hiretrack-v*.tar.gz
/hiretrack-v*.tar.gz.manifest.json
/hiretrack-v*.tar.gz.part-*
/temp/hiretrack-v*.tar.gz
